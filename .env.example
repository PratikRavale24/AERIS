# AERIS — Environment Configuration
# Copy to .env and update values. Do NOT commit .env.
# Real secrets are generated by scripts/gen_secrets.sh into secrets/ directory.

# Application
APP_NAME=AERIS
APP_ENV=development
LOG_LEVEL=INFO

# PostgreSQL (container-internal)
POSTGRES_DB=aeris
POSTGRES_USER=aeris_admin
# Password is in secrets/db_password — do NOT put it here

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_WORKERS=2

# JWT
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10
JWT_REFRESH_TOKEN_EXPIRE_HOURS=8
SESSION_IDLE_TIMEOUT_MINUTES=15
SESSION_ABSOLUTE_TIMEOUT_HOURS=8

# Rate limits
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_API=120/minute
RATE_LIMIT_UPLOAD=10/hour

# ML
RUL_REF_CYCLES=100
FAILURE_HORIZON_CYCLES=30
AVAILABILITY_TARGET_PERCENT=70

# nginx
NGINX_HTTPS_PORT=8443
